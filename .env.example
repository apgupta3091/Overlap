# Overlap — copy to .env.local and fill in. Nothing here is required for /demo.

# Base URL of the Overlap API (Supabase Edge Function), e.g. http://127.0.0.1:54321/functions/v1/api
# Leave empty to run demo-only.
VITE_API_URL=

# Analytics adapter: empty = disabled (default), "console" = log events in dev.
VITE_ANALYTICS=

# Server-side only (Edge Function secrets) — NEVER prefix with VITE_ or expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=
# ALLOWED_ORIGINS=http://localhost:5173
