# Shortlist runs in demo mode with no variables set.
# To enable accounts and shared boards, point these at a Supabase project (local or hosted).
# Only the public "anon"/publishable key belongs here — NEVER put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Optional: "console" logs analytics events in the browser console. Unset = analytics disabled.
VITE_ANALYTICS=
